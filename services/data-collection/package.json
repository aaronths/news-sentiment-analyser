{
  "scripts": {
    "dev": "cross-env NEWS_DATA_STORAGE_MODE=local-file npm run ingest",
    "prod": "cross-env NODE_ENV=production NEWS_DATA_STORAGE_MODE=s3 npm run ingest",
    "ingest": "ts-node-dev --respawn --transpile-only src/scripts/run-ingestion.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "jest",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "build:lambda": "node esbuild.config.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "dotenv": "^17.2.2",
    "express": "^4.18.0",
    "fast-xml-parser": "^5.5.5",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
