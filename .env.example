# News APIs
GUARDIAN_API_KEY=your-guardian-api-key
NYT_NEWS_API_KEY=your-nyt-news-api-key
NYT_NEWS_API_URL=https://api.nytimes.com/svc/topstories/v2/home.json
NYT_MOST_POPULAR_API_URL=https://api.nytimes.com/svc/mostpopular/v2/viewed/1.json

# RSS feeds (provider-owned feed URLs)
BBC_NEWS_RSS_URL=https://feeds.bbci.co.uk/news/rss.xml
REUTERS_RSS_URL=https://feeds.reuters.com/reuters/topNews
ABC_NEWS_RSS_URL=https://www.abc.net.au/news/feed/51120/rss.xml
SBS_NEWS_RSS_URL=https://www.sbs.com.au/news/podcastfeeds/news.rss

# Local ingest controls
INGEST_PER_SOURCE=10
# INGEST_SOURCE_IDS=guardian,nyt,nyt-most-popular,bbc,reuters,abc,sbs
# Set an interval to keep ingest running (milliseconds). Leave undefined to run once.
# INGEST_INTERVAL_MS=60000
# Optional: limit number of iterations when running on a loop.
# INGEST_MAX_ITERATIONS=0
# Optional: fetch more pages (useful for backfilling older stories on supported sources)
# INGEST_PAGES=1

# AWS / S3
NEWS_DATA_STORAGE_MODE=local-file
AWS_REGION=ap-southeast-2
NEWS_DATA_BUCKET=your-news-data-bucket
NEWS_DATA_RAW_KEY=raw/raw-articles.json
NEWS_DATA_CLEAN_KEY=clean/clean-articles.json
RUNTIME_CACHE_TTL_SECONDS=300

# Optional local ports
DATA_COLLECTION_PORT=8000
DATA_RETRIEVAL_PORT=8001
TESTING_PORT=8002
RUNTIME_UI_PORT=4173

# Testing
X_API_KEY=our-api-key-here
TARGET_API_URL=deployment-url-here